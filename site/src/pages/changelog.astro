---
import { Icon } from "astro-icon/components";
import { changelogPageContent, identity } from "../config";
import Layout from "../layout.astro";
import { releases } from "../releases";

const all = releases();
const formatter = new Intl.DateTimeFormat("en", { year: "numeric", month: "long", day: "numeric" });
---

<Layout seo={changelogPageContent.seo}>
    <section class="px-6 pt-16 pb-10 max-w-6xl mx-auto">
        <h1 class="font-bold text-3xl lg:text-4xl tracking-tight mb-3">Changelog</h1>
        <p class="text-muted text-sm">{changelogPageContent.subtitle}</p>
    </section>

    <section class="px-6 pb-10 max-w-6xl mx-auto">
        {all.length === 0 && <p class="text-muted">No releases yet.</p>}

        <div class="flex flex-col">
            {
                all.map((release) => (
                    <article class="grid lg:grid-cols-[16rem_1fr] gap-4 lg:gap-12 py-9 border-t border-line">
                        <div class="lg:pt-0.5">
                            <h2 class="font-semibold text-xl tracking-tight">{release.version}</h2>
                            <time class="text-sm text-muted" datetime={release.date}>
                                {formatter.format(new Date(`${release.date}T00:00:00Z`))}
                            </time>
                        </div>
                        <div>
                            <ul class="flex flex-col gap-2.5 mb-5">
                                {release.notes.map((note) => (
                                    <li class="text-muted text-sm flex gap-3">
                                        <span aria-hidden="true" class="select-none">
                                            ·
                                        </span>
                                        <span>{note}</span>
                                    </li>
                                ))}
                            </ul>
                            <a
                                href={`${identity.repo}/releases/tag/${release.tag}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-fg transition-colors"
                            >
                                <span>Download {release.version}</span>
                                <Icon name="mdi:arrow-top-right" width={14} height={14} aria-hidden="true" />
                            </a>
                        </div>
                    </article>
                ))
            }
        </div>
    </section>
</Layout>
